# Ekagra Library: settings for the live site (Vercel).
#
# How to use:
#   1. Copy this file to a private place (NOT into Git), fill in every value.
#   2. Vercel > your project > Settings > Environment Variables: paste the whole
#      filled-in file into the "Key" box. Vercel splits it into variables.
#      Choose the "Production" environment, then Save and redeploy.
#   3. Never commit the filled-in copy. This template holds placeholders only.
#
# Values marked SAME AS LOCAL must match your .env.local exactly.

# --- Site ---------------------------------------------------------------
# The live address, no trailing slash. Used for canonical links, the sitemap,
# structured data and social previews.
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# --- Database (Neon) ------------------------------------------------------
# Neon console > project > Connect > Connection pooling ON > copy the string.
# No separate Neon API key is needed. SAME AS LOCAL if both use one database.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require

# --- Encryption of ID numbers and documents --------------------------------
# SAME AS LOCAL, character for character. A different key makes every saved
# Aadhaar/PAN/licence number and document unreadable. Keep a backup copy.
DOCUMENTS_KEY=<64 hex characters, copied from .env.local>

# --- Admin sign-in (Neon Auth / Better Auth) ---------------------------------
# Neon console > project > Auth: the Auth URL.
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth
# A new random string of at least 32 characters (it may differ from local).
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=<random string, 32+ characters>
# Who may sign in to the admin, comma-separated.
ADMIN_EMAILS=<owner email>[,<helper email>]
# Optional secret admin address, e.g. desk-7fq2k9 -> https://<your-domain>/desk-7fq2k9
# and /admin becomes a 404. Leave empty to use /admin.
ADMIN_PATH=

# --- Fee reminders by email (Gmail) -------------------------------------------
# A Gmail account with 2-Step Verification on, and an App Password from
# myaccount.google.com > Security > App passwords. Empty = dry runs only.
GMAIL_USER=<sending gmail address>
GMAIL_APP_PASSWORD=<16-character app password>
# Where your daily list of due fees goes. Defaults to GMAIL_USER.
OWNER_EMAIL=<owner email>

# --- Daily scheduler ----------------------------------------------------------
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" by itself.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=<random string>

# --- Not used yet (see docs/Ekagra-Library-integrations-and-deployment.pdf) ---
# Automatic WhatsApp reminders through Meta's WhatsApp Cloud API.
# WHATSAPP_ACCESS_TOKEN=<permanent system-user token>
# WHATSAPP_PHONE_NUMBER_ID=<phone number ID>
# WHATSAPP_BUSINESS_ACCOUNT_ID=<WhatsApp Business Account ID>
# WHATSAPP_TEMPLATE_NAME=<approved template name, e.g. fee_reminder>
# Google Forms -> database sync (registration and payment forms).
# INTAKE_SECRET=<random string shared with the Google Apps Script>
