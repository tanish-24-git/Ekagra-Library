# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site, used for social previews, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string (Neon console > Connection details).
# Leave empty to run the admin on in-memory sample data.
DATABASE_URL=

# Admin sign-in with Neon Auth (Neon console > your project > Auth).
# Leave ADMIN_EMAILS empty in development to open /admin with no login.
# On the live site all three are required; without them every admin URL answers 404.
NEON_AUTH_BASE_URL=
# At least 32 random characters. Signs the sign-in cookies.
NEON_AUTH_COOKIE_SECRET=
# Who may sign in, comma-separated.
ADMIN_EMAILS=
# Optional secret address for the admin, e.g. desk-7fq2k9 serves it at
# https://your-site/desk-7fq2k9 and makes /admin a 404.
ADMIN_PATH=
# Generate a cookie secret, a documents key and a secret path with:
#   node -e "const c=require('crypto');console.log(c.randomBytes(36).toString('base64url'), c.randomBytes(32).toString('hex'), 'desk-'+c.randomBytes(5).toString('hex'))"

# Encrypts students' Aadhaar and PAN numbers and their ID documents.
# 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe: without it, stored documents can't be read.
# Required on the live site.
DOCUMENTS_KEY=
