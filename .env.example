# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site, used for social previews, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string (Neon console > Connection details).
# Leave empty to run the admin on in-memory sample data.
DATABASE_URL=

# Admin. Leave all three empty in development to open /admin with no login.
# On the live site all three are required; without them every admin URL answers 404.
# ADMIN_PATH is the secret address of the admin, e.g. desk-7fq2k9 serves it at
# https://your-site/desk-7fq2k9. /admin itself always answers 404.
# Generate values with:
#   node -e "const c=require('crypto');console.log('desk-'+c.randomBytes(5).toString('hex'), c.randomBytes(12).toString('base64url'), c.randomBytes(32).toString('hex'))"
ADMIN_PATH=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Encrypts students' Aadhaar and PAN numbers and their ID documents.
# 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe: without it, stored documents can't be read.
# Required on the live site.
DOCUMENTS_KEY=
