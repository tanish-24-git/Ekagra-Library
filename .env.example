# Copy to .env and fill in. The same .env works on your computer and, pasted
# into Vercel's Environment Variables, on the live site. Never commit .env.

# Optional. The site's address is worked out automatically (localhost on
# your computer, the Vercel address or your domain when live). Set it only to override.
# NEXT_PUBLIC_SITE_URL=https://your-domain

# Neon Postgres connection string (Neon console > Connection details).
# Leave empty to run the admin on in-memory sample data.
DATABASE_URL=

# Admin sign-in with Neon Auth (Neon console > your project > Auth).
# Leave ADMIN_EMAILS empty in development to open /admin with no login.
# On the live site all three are required; without them every admin URL answers 404.
NEON_AUTH_BASE_URL=
# At least 32 random characters. Signs the sign-in cookies.
NEON_AUTH_COOKIE_SECRET=
# Who may sign in, comma-separated.
ADMIN_EMAILS=
# Optional secret address for the admin, e.g. desk-7fq2k9 serves it at
# https://your-site/desk-7fq2k9 and makes /admin a 404.
ADMIN_PATH=
# Generate a cookie secret, a documents key and a secret path with:
#   node -e "const c=require('crypto');console.log(c.randomBytes(36).toString('base64url'), c.randomBytes(32).toString('hex'), 'desk-'+c.randomBytes(5).toString('hex'))"

# Fee reminders by email, through Gmail with an App Password (Google account >
# Security > 2-Step Verification on > App passwords). Empty = dry runs only.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where your daily list goes. Defaults to GMAIL_USER.
OWNER_EMAIL=
# The daily scheduler calls /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>".
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Encrypts students' Aadhaar and PAN numbers and their ID documents.
# 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe: without it, stored documents can't be read.
# Required on the live site.
DOCUMENTS_KEY=

# Google Forms -> database (registration and payment forms). Empty = off.
# When you connect: generate a random value, put it here and in the Apps Script
# (scripts/google-forms/intake.gs). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INTAKE_SECRET=

# Automatic WhatsApp reminders (Meta WhatsApp Cloud API). Empty = off; the
# Send on WhatsApp buttons work meanwhile. See the setup guide, section 2B.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Optional: template language (default en) and Graph API version (default v23.0).
WHATSAPP_TEMPLATE_LANG=
WHATSAPP_API_VERSION=
